{
  "name": "mofang-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "魔方数字资产管理 Electron 桌面客户端",
  "author": "Jiakuo Zhang",
  "repository": "https://github.com/Jiakuo0x/mofang-digital-asset-management.git",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "pack:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "pack:mac": "npm run build && electron-builder --mac zip --universal --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "26.15.3",
    "oxlint": "^1.79.0",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
